generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["trader"]
}

model tradersData {
  id              Int      @id @default(autoincrement())
  channelId       String   @unique
  period          String?
  username        String
  rank            String?
  medal           Int?
  subscribers     Int?
  price           Float?
  ageMonths       Int?
  winCount        Int?
  lossCount       Int?
  drawCount       Int?
  postedSignal    Int?
  settledSignal   Int?
  avgTpPips       Float?
  avgSlPips       Float?
  consWin         Int?
  consLoss        Int?
  avgHoldSec      Int?
  extraData       Json?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@schema("trader")
}

model tblAntrian {
  id              Int      @id @default(autoincrement())
  idChannel       String   @unique
  process         String?
  active          Boolean? @default(false)
  errorCount      Int?
  lastError       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@schema("trader")
}

model tradersDataArchive {
  id              Int      @id @default(autoincrement())
  channelId       String
  period          String?
  username        String?
  rank            String?
  medal           Int?
  subscribers     Int?
  price           Float?
  ageMonths       Int?
  winCount        Int?
  lossCount       Int?
  drawCount       Int?
  postedSignal    Int?
  settledSignal   Int?
  avgTpPips       Float?
  avgSlPips       Float?
  consWin         Int?
  consLoss        Int?
  extraData       Json?
  periodLabel     String?
  archivedAt      DateTime @default(now())

  @@schema("trader")
}
