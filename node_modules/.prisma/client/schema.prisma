generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TradersData {
  id            Int      @id @default(autoincrement())
  channelId     String   @unique @map("channel_id")
  period        String   @default("1Y")
  username      String?
  rank          String?  @default("-")
  medal         String?  @default("-")
  subscribers   Int?     @default(0)
  price         Decimal? @default(0) @db.Decimal(15, 2)
  ageMonths     Int?     @default(0) @map("age_months")
  winCount      Int?     @default(0) @map("win_count")
  lossCount     Int?     @default(0) @map("loss_count")
  drawCount     Int?     @default(0) @map("draw_count")
  postedSignal  Int?     @default(0) @map("posted_signal")
  settledSignal Int?     @default(0) @map("settled_signal")
  avgTpPips     Decimal? @default(0) @map("avg_tp_pips") @db.Decimal(10, 2)
  avgSlPips     Decimal? @default(0) @map("avg_sl_pips") @db.Decimal(10, 2)
  consWin       Int?     @default(0) @map("cons_win")
  consLoss      Int?     @default(0) @map("cons_loss")
  avgHoldSec    Int?     @default(0) @map("avg_hold_sec")
  extraData     Json?    @map("extra_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  historySignals TradersHistorySignal[]

  @@map("traders_data")
}

model TradersHistorySignal {
  id         Int       @id @default(autoincrement())
  channelId  String    @map("channel_id")
  signalId   String    @map("signal_id")
  symbol     String
  type       String
  openTime   DateTime  @default(now()) @map("open_time")
  closeTime  DateTime? @map("close_time")
  openPrice  Decimal?  @map("open_price") @db.Decimal(20, 5)
  closePrice Decimal?  @map("close_price") @db.Decimal(20, 5)
  pips       Decimal?  @db.Decimal(10, 2)
  profit     Decimal?  @default(0) @db.Decimal(20, 8)
  status     String
  createdAt  DateTime  @default(now()) @map("created_at")

  trader TradersData @relation(fields: [channelId], references: [channelId])

  @@unique([channelId, signalId])
  @@index([channelId, closeTime], map: "idx_ths_channel_close")
  @@map("traders_history_signals")
}

model TblAntrian {
  id        Int      @id @default(autoincrement())
  idChannel String   @unique @map("id_channel")
  process   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tbl_antrian")
}

model TradersDataArchive {
  id            Int      @id @default(autoincrement())
  channelId     String   @map("channel_id")
  period        String
  username      String?
  rank          String?
  medal         String?
  subscribers   Int?
  price         Decimal? @db.Decimal(12, 2)
  ageMonths     Int?     @map("age_months")
  winCount      Int?     @map("win_count")
  lossCount     Int?     @map("loss_count")
  drawCount     Int?     @map("draw_count")
  postedSignal  Int?     @map("posted_signal")
  settledSignal Int?     @map("settled_signal")
  avgTpPips     Decimal? @map("avg_tp_pips") @db.Decimal(10, 2)
  avgSlPips     Decimal? @map("avg_sl_pips") @db.Decimal(10, 2)
  consWin       Int?     @map("cons_win")
  consLoss      Int?     @map("cons_loss")
  extraData     Json?    @map("extra_data")
  archivedAt    DateTime @default(now()) @map("archived_at")
  periodLabel   String   @map("period_label")

  @@map("traders_data_archive")
}
